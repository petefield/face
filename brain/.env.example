OPENAI_MODEL=qwen3:8b
FACE_URL=http://blinky.local:5000
SPEECH_URL=http://host.docker.internal:5060/speak
HOMEASSISTANT_URL=http://pippin:8123/
HOMEASSISTANT_TOKEN=
GOOGLE_CALENDAR_ID=
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=
XWEATHER_DEFAULT_LOCATION=London,UK
